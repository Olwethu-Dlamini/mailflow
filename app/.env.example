# Copy to .env next to docker-compose.yml (chmod 600). Never commit the real file.

# n8n, reached inside the automation stack's Docker network
N8N_URL=http://n8n:5678
# n8n → Settings → n8n API → Create an API key just for this app
N8N_API_KEY=
# The "MailFlow emails" data table
MAILFLOW_TABLE_ID=HwHXJgR6FLgD8aeS
# The value of the n8n credential "MailFlow app secret" (Header Auth, header X-MailFlow-Secret)
N8N_REPLY_SECRET=

# The public address; POSTs from any other origin are refused
SITE_ORIGIN=https://mailflow.22112002.xyz
# REQUIRED: srv1's LAN address (on srv1: hostname -I). Cloudflare's Cf-Connecting-IP is believed
# only on requests from it; without it every visitor would share one address for the login lockout.
# Use "none" only when testing without a proxy.
TRUSTED_PROXY=
# Only for testing over plain http; leave true on the server
COOKIE_SECURE=true
DB_PATH=/data/mailflow.db
