# Copy to .env next to docker-compose.yml (chmod 600). Never commit the real file.
# REQUIRED lines must have a value or the app does not start. The rest may stay as they are.

# n8n, reached inside the automation stack's Docker network
N8N_URL=http://n8n:5678
# REQUIRED. n8n → Settings → n8n API → Create an API key just for this app
N8N_API_KEY=
# REQUIRED. The id of the "MailFlow emails" data table (n8n → Data tables → open it: the id is in the address)
MAILFLOW_TABLE_ID=
# REQUIRED. The value of the n8n credential "MailFlow app secret" (Header Auth, header X-MailFlow-Secret)
N8N_REPLY_SECRET=
# The MailFlow · Reply webhook, only if it is not at N8N_URL/webhook/mailflow/reply
# N8N_REPLY_URL=http://n8n:5678/webhook/mailflow/reply

# REQUIRED. The public address, like https://mail.example.com; POSTs from any other origin are refused
SITE_ORIGIN=
# REQUIRED. The LAN address of the proxy in front of the app (srv1 for the owner's copy; on it:
# hostname -I). Cloudflare's Cf-Connecting-IP is believed only on requests from it; without it every
# visitor would share one address for the login lockout. Use "none" only when testing without a proxy.
TRUSTED_PROXY=
# Only for testing over plain http; leave true on the server
COOKIE_SECURE=true
DB_PATH=/data/mailflow.db
# The time zone the page shows dates and times in (an IANA name such as Europe/London).
# An unknown name stops the app at start-up.
MAILFLOW_TIME_ZONE=Africa/Mbabane

# Where docker compose publishes the app: this host's LAN address that the proxy reaches, and a port.
# Use an address only the proxy can reach, so nobody goes around it.
MAILFLOW_BIND=10.0.0.31
MAILFLOW_PORT=3100
# The Docker network n8n is on (docker network ls); the app reaches n8n through it
AUTOMATION_NETWORK=automation_default

# Optional "Continue with Google" (app/README.md): an OAuth client of type Web application whose
# redirect URI is SITE_ORIGIN/auth/google/callback. Set both, or leave both empty to keep it off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seals the SMTP passwords for replies from mailboxes other than Gmail (Integrations, admins).
# The deploy script creates one if it is missing. Make one by hand: openssl rand -base64 32 | tr '+/' '-_'
# Changing or losing it means entering those SMTP passwords again: keep a copy (deploy/backup.sh does).
MAILFLOW_SECRET_KEY=
