    {
      "id": "9a61eb9a-b339-4501-bad0-067db482dec6",
      "name": "Sort with AI",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "onError": "continueRegularOutput",
      "position": [
        680,
        120
      ],
      "parameters": {
        "text": "=From: {{ $json.from_name }} <{{ $json.from_address }}>\nSubject: {{ $json.subject }}\n\n{{ ($json.body || '').slice(0, 4000) }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Registration\",\n        \"Team\",\n        \"Rules & judging\",\n        \"Submission\",\n        \"Sponsorship\",\n        \"Mentor/Judge\",\n        \"Volunteer\",\n        \"Logistics\",\n        \"Prizes & payouts\",\n        \"Media/press\",\n        \"Withdrawal\",\n        \"Code of conduct\",\n        \"Platform notification\",\n        \"Marketing\",\n        \"Other\"\n      ],\n      \"description\": \"The topic, chosen with the topic rules in the instructions.\"\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"P1\",\n        \"P2\",\n        \"P3\"\n      ],\n      \"description\": \"P1, P2 or P3, chosen with the priority rules in the instructions.\"\n    },\n    \"sender\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Participant\",\n        \"Sponsor\",\n        \"Mentor/Judge\",\n        \"Volunteer\",\n        \"Vendor/Venue\",\n        \"Press\",\n        \"Organiser\",\n        \"Automated\",\n        \"Other\"\n      ],\n      \"description\": \"Who wrote the email, chosen with the sender rules in the instructions.\"\n    },\n    \"needs_reply\": {\n      \"type\": \"boolean\",\n      \"description\": \"true if an organiser must answer this email, false for automatic messages, newsletters and simple thank-yous\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"What the email says, one short sentence, at most 15 words\"\n    },\n    \"next_step\": {\n      \"type\": \"string\",\n      \"description\": \"What the organisers should do next, at most 12 words, starting with a verb\"\n    }\n  },\n  \"required\": [\n    \"type\",\n    \"priority\",\n    \"sender\",\n    \"needs_reply\",\n    \"summary\",\n    \"next_step\"\n  ]\n}",
        "options": {
          "systemPromptTemplate": "You sort emails that arrive at the organisers of a hackathon. Read the email and fill in every field.\n\nChoose the topic (\"type\") by asking: what does this email mainly want? Pick exactly one:\n- Registration: ONLY signing up, tickets, a place on the waiting list, or confirming attendance.\n- Team: finding teammates, forming, changing or merging a team.\n- Rules & judging: what is allowed, eligibility of a project, judging criteria, scores, results.\n- Submission: handing in a project, deadlines, extensions, upload or Devpost problems.\n- Sponsorship: a company GIVING money or support to the hackathon as a sponsor: packages, benefits, logos, contracts, sponsor invoices.\n- Mentor/Judge: mentors or judges: invitations, availability, judging schedule.\n- Volunteer: offering to help, volunteer shifts.\n- Logistics: venue, power, WiFi, schedule, travel, accommodation, food and dietary needs, parking, accessibility, visa or invitation letters.\n- Prizes & payouts: prize money, paying winners, bank details.\n- Media/press: journalists, interviews, photos, filming, blog or social media requests.\n- Withdrawal: someone cancels or can no longer attend.\n- Code of conduct: harassment, feeling unsafe, discrimination, inappropriate behaviour, reports about another person.\n- Platform notification: automatic messages from Devpost, Eventbrite, Luma, MLH, Google Forms.\n- Marketing: newsletters, promotions, and suppliers trying to SELL us something (discounts, quotes for products or services).\n- Other: none of the above.\nMost emails are NOT Registration. A participant asking about food, rules, teams or submissions gets that topic, not Registration.\n\nChoose the sender: Participant, Sponsor, Mentor/Judge, Volunteer, Vendor/Venue (venue, catering, swag, printing or other supplier), Press, Organiser, Automated, or Other.\n\nPriority: P1 = answer today (code of conduct or safety, a problem during the event such as power or venue, a submission problem near the deadline, sponsor commitments, payments or prize money). P2 = answer this week (normal questions, registrations, teams, logistics, mentors, volunteers, press). P3 = no answer needed (thanks, FYI, notifications, newsletters).\n\nneeds_reply is true when an organiser must answer. summary: one short sentence, at most 15 words. next_step: what the organisers should do next, at most 12 words, starting with a verb.\n\nAnswer with the values only, as one JSON object with exactly these six keys. Do not repeat or describe the schema. The form is:\n{\"type\": \"<one topic from the list>\", \"priority\": \"<P1, P2 or P3>\", \"sender\": \"<one sender from the list>\", \"needs_reply\": <true or false>, \"summary\": \"<one short sentence>\", \"next_step\": \"<what to do next>\"}"
        }
      }
    },
